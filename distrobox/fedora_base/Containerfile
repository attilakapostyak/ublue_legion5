FROM fedora:latest

# Set flag to auto accept on dnf install
RUN echo "defaultyes=True" >> /etc/dnf/dnf.conf

# Important tools
RUN dnf install -y\
      git\
      jq\
      chezmoi\
      htop\
      btop\
      mc

# NodeJS
RUN dnf install -y nodejs

# bw command
RUN npm install -g @bitwarden/cli


# Rust
ENV RUSTUP_HOME=/usr/local/rustup

RUN mkdir -p /usr/local/rustup \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
       | CARGO_HOME=/usr/local \
         RUSTUP_HOME=/usr/local/rustup \
         sh -s -- \
           -y \
           --no-modify-path \
           --profile default \
           --default-toolchain stable \
    && CARGO_HOME=/usr/local \
       rustup component add rustfmt clippy \
    && chmod -R a+rX /usr/local/rustup


############
# AI Tools #
############

# Claude 
RUN npm install -g \
   --prefix /usr/local \
   @anthropic-ai/claude-code

# Pi
RUN npm install -g \
    --prefix /usr/local \
    --ignore-scripts \
    @earendil-works/pi-coding-agent

# Codex
RUN HOME="/usr/local" && curl -fsSL https://chatgpt.com/codex/install.sh | sh

// Extra key bindings. Installed by `just niri-setup`.
// Binds here win over the same key in config.kdl, because the include line
// comes after the binds block there.

binds {
    // DMS launcher: start apps, search files and settings, calculate
    // ("2+2", Enter copies the result; needs the calculator plugin that
    // `just niri-setup` installs).
    Mod+Space hotkey-overlay-title="Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
}

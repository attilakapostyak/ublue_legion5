# Desktop applications from Flathub, installed system-wide.
# Homebrew is only the front-end here (`brew bundle` runs `flatpak install`),
# the same way Aurora manages its own default apps.
#
# Install:  just apps-install
# Remove:   delete the line, then `just apps-cleanup` (dry run) and
#           `just apps-cleanup --force`
# Find IDs: flatpak search <name>   or   https://flathub.org
#
# Aurora's default apps (Firefox, Thunderbird, Okular, ...) are managed by
# Aurora itself and don't need to be listed. VS Code ships in the DX image.

flatpak "app.zen_browser.zen"
flatpak "com.bitwarden.desktop"
flatpak "com.google.Chrome"
flatpak "com.slack.Slack"
flatpak "com.valvesoftware.Steam"
flatpak "com.vivaldi.Vivaldi"
flatpak "md.obsidian.Obsidian"

# Command-line tools for the host, installed with Homebrew into your user
# space (/home/linuxbrew). No reboot needed; Aurora updates them automatically.
#
# Install:  just apps-install
# Remove:   delete the line, then `just apps-cleanup` (dry run) and
#           `just apps-cleanup --force`
#
# Already in the base image, don't add here: git, jq, htop, vim, tmux, just.
# Development tools (compilers, runtimes, AI coding agents) go in a distrobox.

brew "bitwarden-cli"
brew "btop"
brew "chezmoi"
brew "gh"
brew "midnight-commander"
brew "neovim"
